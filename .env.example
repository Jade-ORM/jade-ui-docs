# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Dev callback (via Vite proxy): http://localhost:5173/api/auth/callback
# Prod callback: https://<your-domain>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts session cookies (any long random string)
SESSION_SECRET=

# Frontend origin (post-OAuth redirect). Local: http://localhost:5173
PUBLIC_SITE_URL=

# Optional: public origin of the API when it differs from the request host
# API_ORIGIN=http://localhost:5173

# Upstash Redis or Vercel KV (REST). Local file store is used when unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# — or —
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
