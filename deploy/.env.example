# Copy to deploy/.env (never commit .env)

# --- Published ports on the host ---
FRONT_PORT=8080
BACK_PORT=8787

# --- Front build ---
# Leave empty for same-origin /api (nginx → back). Set only if the API is on another host.
VITE_PLUGIN_API_URL=

# --- GitHub OAuth App ---
# Authorization callback URL (same-origin via nginx):
#   http://localhost:8080/api/auth/callback
#   https://<your-front-host>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Session / CORS ---
# Generate: openssl rand -hex 32
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
API_ORIGIN=http://localhost:8080

# --- Listings store ---
# Default (empty): file store on volume plugin-data
# Optional production: Upstash / Vercel KV REST
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Build context for plugin-api (relative to deploy/) ---
# Default assumes: <parent>/jade-ui-docs  and  <parent>/plugin-api
PLUGIN_API_CONTEXT=../../plugin-api
